# Copy this file to .env.local. Every key is optional: a check without its key
# is reported as "Not checked" and never counts for or against a website.

# AI agents. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used by both agents (default: gemini-2.5-flash), and the one tried when
# the first is out of quota (default: gemini-2.5-flash-lite).
# PHISHGUARD_MODEL=gemini-2.5-flash
# PHISHGUARD_FALLBACK_MODEL=gemini-2.5-flash-lite

# Website checks. Domain age (RDAP) and redirect tracing need no key.
# Trustpilot Business Units API: https://developers.trustpilot.com/
TRUSTPILOT_API_KEY=
# Google Safe Browsing Lookup API v4: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal API v3: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Set to "off" to make no outbound requests about pasted links at all.
# PHISHGUARD_SITE_CHECKS=off
