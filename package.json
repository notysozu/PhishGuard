{
  "name": "phishguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.{ts,tsx}\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include=\"lib/**\" --test-coverage-include=\"app/api/**\" --test-coverage-include=\"components/**\" \"tests/**/*.test.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "Explainable phishing checker: a two-agent LangGraph workflow that shows why a message is a scam and what to do next.",
  "license": "MIT"
}
